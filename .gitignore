# Python
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/
.venv/
venv/

# Secrets — never commit
.env

# Runtime data (local SQLite + logs, persisted via the Docker bind mount)
data/*.db
data/*.db-wal
data/*.db-shm
data/logs/*.log*
data/logs-trip-watch/*.log*
!data/.gitkeep
!data/logs/.gitkeep

# Spike raw dumps are throwaway and can be large/numerous — keep the folder, not the bulk
spike/responses/*.json
!spike/responses/.gitkeep

# Resultats de recherches ad-hoc (scripts/search_custom_route.py) : donnees de voyage
# personnelles (potentiellement d'un tiers), jamais commitees
scripts/search_results/

# OS
.DS_Store
Thumbs.db

# Interface d'edition : anciennes versions et fichiers temporaires (locaux a la machine)
config/.history/
watches/.history/
.*.yaml.tmp

# Registre des cles publie par le service des alertes (local, regenere)
status/*.json
watches/.archive/

# Veilles bons plans creees depuis l'interface (reglages locaux a la machine)
deals/*.yaml
deals/.history/
deals/.archive/

# Secrets ajoutes depuis l'interface (bots Telegram des amis, cles SerpApi) : jamais commites
secrets/*
!secrets/.gitkeep

# Sauvegarde nocturne (ops/backup.py) : journal local
logs/
