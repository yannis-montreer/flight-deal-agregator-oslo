# Copie ce fichier en ".env" (jamais commité) et remplis les valeurs reelles.

# SerpApi — cle gratuite sur https://serpapi.com/manage-api-key (~250 recherches/mois)
SERPAPI_KEY=

# Bot Telegram — cree via @BotFather sur Telegram, puis recupere le chat_id
# via https://api.telegram.org/bot<TOKEN>/getUpdates apres avoir envoye un message au bot
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Optionnel — cle SEPAREE pour scripts/search_custom_route.py (recherches ad-hoc a la
# demande, ex: pour un tiers). Recommande pour ne pas consommer le quota de SERPAPI_KEY
# utilise par le systeme de monitoring quotidien. Si absente, le script retombe sur
# SERPAPI_KEY.
SEARCH_SERPAPI_KEY=
